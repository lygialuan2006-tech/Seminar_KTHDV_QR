# Copy to .env for Docker Compose. Generate fresh secrets before deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUSTED_HOSTS=attendance.example.com
DATABASE_URL=postgresql+psycopg://attendance:replace-me@localhost:5432/attendance
APP_ENV=production
SESSION_HTTPS_ONLY=1
QR_VALIDITY_SECONDS=86400
QR_PUBLIC_BASE_URL=https://attendance.example.com
# Optional. JSON map key ID -> base64 32-byte key; never expose to frontend.
# QR_AES_KEYS={"v1":"base64-encoded-32-byte-key"}
